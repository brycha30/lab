TZ=America/New_York
PUID=
PGID=
# TrueNAS mount on Docker host; all media services share this filesystem for hardlinks.
MAIN=/mnt/Main
KIDS_MAIN=/mnt/KidsMain
WATCHLIST_CLEANUP_ROOT=/opt/dkr/watchlist-cleanup
CONFIG_ROOT=/opt/dkr/config
STACKS_ROOT=/opt/lab/stacks

# Caddy / Cloudflare DNS challenge
CLOUDFLARE_API_TOKEN=

# WireGuard (Mullvad); set actual values only in the untracked local .env.
VPN_SERVICE_PROVIDER=
VPN_TYPE=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=
DNS_ADDRESS=
WIREGUARD_PUBLIC_KEY=

# Gluetun LAN/NAS access and published media WebUI ports.
FIREWALL_OUTBOUND_SUBNETS=
FIREWALL_INPUT_PORTS=5055,8080,9696,8989,7878,7879,7880,6767,6768,6769,8191,6881
